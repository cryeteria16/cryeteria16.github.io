rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {

    match /portfolio/{document} {
      allow read: if true;
      allow write: if request.auth != null;
    }
    match /system/profile {
      allow read: if true;
      allow write: if request.auth != null;
    }
    match /system/config {
      allow read: if true;
      allow write: if request.auth != null;
    }

    match /radar_logs/{document} {
      allow create: if true
                    && request.resource.data.keys().hasAll(['type', 'ip', 'city', 'country', 'device', 'timestamp'])
                    && request.resource.data.type is string;
      allow read, update, delete: if request.auth != null;
    }
    match /system/analytics {
      allow read, write: if request.auth != null;
    }

    match /guest_chat/{document} {
      allow read, create: if true;
      allow update, delete: if request.auth != null;
    }
    match /system/watch_party {
      allow read: if true;
      allow write: if request.auth != null;
    }
    match /watchlist/{document} {
      allow read: if true;
      allow write: if request.auth != null;
    }

    match /chat/{document} {
      allow read, write: if request.auth != null;
    }

    // Voice Room WebRTC signaling. Docs are short-lived (deleted on hangup)
    // and only ever hold SDP offers/answers + ICE candidates, never audio
    // itself (that's peer-to-peer), so authenticated read/write is enough.
    match /voice_calls/{callId} {
      allow read, write: if request.auth != null;
      match /callerCandidates/{document} {
        allow read, write: if request.auth != null;
      }
      match /calleeCandidates/{document} {
        allow read, write: if request.auth != null;
      }
    }

    match /system/{document} {
      allow read, write: if request.auth != null;
    }
    match /users/{userId} {
      // RULE UPDATED: Any authenticated user can read (for live presence)
      allow read: if request.auth != null;
      allow write: if request.auth != null && request.auth.uid == userId;
    }
  }
}
