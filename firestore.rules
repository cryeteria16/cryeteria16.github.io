rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {
    
    // 1. PUBLIC PORTFOLIO & IDENTITY (Open read, Admin write)
    match /portfolio/{document} {
      allow read: if true;
      allow write: if request.auth != null;
    }
    match /system/profile {
      allow read: if true;
      allow write: if request.auth != null;
    }
    match /system/config {
      allow read: if true;
      allow write: if request.auth != null;
    }
    
    // 2. THE OVERSEER (Strict Schema Protection against quota exhaustion)
    match /radar_logs/{document} {
      allow create: if true 
                    && request.resource.data.keys().hasAll(['type', 'ip', 'city', 'country', 'device', 'timestamp'])
                    && request.resource.data.type is string;
      allow read, update, delete: if request.auth != null;
    }
    match /system/analytics {
      allow read, write: if request.auth != null;
    }

    // 3. GUEST LOUNGE (Open communication, Admin controls playback)
    match /guest_chat/{document} {
      allow read, create: if true;
      allow update, delete: if request.auth != null;
    }
    match /system/watch_party {
      allow read: if true;
      allow write: if request.auth != null;
    }
    match /watchlist/{document} {
      allow read: if true;
      allow write: if request.auth != null;
    }

    // 4. THE LAIR SECURE ZONE (Strictly Auth Only)
    match /chat/{document} {
      allow read, write: if request.auth != null;
    }
    match /system/{document} {
      allow read, write: if request.auth != null;
    }
    match /users/{userId} {
      // Aligned strictly with user.uid
      allow read, write: if request.auth != null && request.auth.uid == userId;
    }
  }
}