rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {

    function isAdmin() {
      return request.auth != null && get(/databases/$(database)/documents/users/$(request.auth.uid)).data.role == 'admin';
    }

    match /portfolio/{document} {
      allow read: if true;
      allow write: if isAdmin();
    }
    match /system/profile {
      allow read: if true;
      allow write: if isAdmin();
    }
    match /system/config {
      allow read: if true;
      allow write: if isAdmin();
    }
    
    match /radar_logs/{document} {
      allow create: if true 
                    && request.resource.data.keys().hasAll(['type', 'ip', 'city', 'country', 'device', 'timestamp'])
                    && request.resource.data.type is string;
      allow read, update, delete: if isAdmin();
    }
    match /system/analytics {
      allow read, write: if isAdmin();
    }

    match /guest_chat/{document} {
      allow read, create: if true;
      allow update, delete: if isAdmin();
    }
    match /system/watch_party {
      allow read: if true;
      allow write: if request.auth != null;
    }
    match /watchlist/{document} {
      allow read: if true;
      allow write: if request.auth != null;
    }

    match /chat/{document} {
      allow read, write: if request.auth != null;
    }

    match /voice_calls/{callId} {
      allow read, write: if request.auth != null;
      match /callerCandidates/{document} {
        allow read, write: if request.auth != null;
      }
      match /calleeCandidates/{document} {
        allow read, write: if request.auth != null;
      }
    }

    match /system/{document} {
      allow read: if request.auth != null;
      allow write: if isAdmin();
    }
    match /users/{userId} {
      allow read: if request.auth != null; 
      allow write: if request.auth != null && request.auth.uid == userId;
    }
  }
}