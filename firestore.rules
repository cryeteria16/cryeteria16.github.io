rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {

    // The Lair belongs to one person: the account whose users/{uid} document has role "admin".
    // Roles can only be set in the Firebase console; nothing on the site can grant one.
    function isOwner() {
      return request.auth != null
        && exists(/databases/$(database)/documents/users/$(request.auth.uid))
        && get(/databases/$(database)/documents/users/$(request.auth.uid)).data.role == 'admin';
    }

    // ---- Public: what visitors to ibadhasan.com can see ----
    match /system/profile {
      allow read: if true;
      allow write: if isOwner();
    }
    match /public_photos/{photo} {
      allow read: if true;
      allow write: if isOwner();
    }
    match /portfolio/{item} {
      allow read: if true;
      allow write: if isOwner();
    }

    // Visitors can add a visit log with exactly these short fields and the server's own time
    match /radar_logs/{log} {
      allow create: if request.resource.data.keys().hasOnly(['type', 'ip', 'city', 'country', 'device', 'timestamp'])
                    && request.resource.data.keys().hasAll(['type', 'ip', 'city', 'country', 'device', 'timestamp'])
                    && request.resource.data.type is string && request.resource.data.type.size() < 50
                    && request.resource.data.ip is string && request.resource.data.ip.size() < 50
                    && request.resource.data.city is string && request.resource.data.city.size() < 100
                    && request.resource.data.country is string && request.resource.data.country.size() < 100
                    && request.resource.data.device is string && request.resource.data.device.size() < 50
                    && request.resource.data.timestamp == request.time;
      allow read, delete: if isOwner();
    }

    // Anyone signed in can read only their own user document (the site uses it to check the
    // role). Nobody can write user documents from the site.
    match /users/{uid} {
      allow read: if request.auth != null && request.auth.uid == uid;
    }

    // ---- Everything else is private to the owner ----
    // (Fridge Door, watchlist, settings, visitor logs, and anything added later)
    match /{document=**} {
      allow read, write: if isOwner();
    }
  }
}
