{
  "name": "The Lair OS",
  "short_name": "Lair",
  "start_url": "/index.html",
  "display": "standalone",
  "background_color": "#0A0A0A",
  "theme_color": "#0A0A0A",
  "icons": [
    {
      "src": "https://upload.wikimedia.org/wikipedia/commons/c/ca/1x1.png",
      "sizes": "512x512",
      "type": "image/png"
    }
  ],
  "share_target": {
    "action": "/lair.html?share=true",
    "method": "POST",
    "enctype": "multipart/form-data",
    "params": {
      "title": "title",
      "text": "text",
      "url": "url",
      "files": [
        {
          "name": "shared_file",
          "accept": ["image/*", "application/pdf"]
        }
      ]
    }
  }
}